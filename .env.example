# Copy this file to `.env.local` and fill in the values from
# Supabase Dashboard → Project Settings → API.
#
# If these are left empty the storefront still runs in a read-only
# "preview mode" backed by src/data/seedProducts.ts, but auth, cart sync,
# checkout, reviews, newsletter and the admin dashboard are disabled.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Public site URL, used for canonical links and password-reset redirects.
VITE_SITE_URL=http://localhost:5173
